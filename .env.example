# Copy to .env and fill in. Never commit .env.

# Language model: gemini | none | replay.
#   none (or an empty key): code-only criteria, audits come back "parcial".
#   replay: development only, serves annotated facts from REPLAY_FACTS_PATH.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

# Free tier guard rails (optional; these are the defaults).
LLM_MAX_CONCURRENCY=4
LLM_REQUESTS_PER_MINUTE=10
LLM_MAX_ATTEMPTS=4
LLM_TIMEOUT_SECONDS=90
EXTRACTION_MAX_ATTEMPTS=2
REPLAY_FACTS_PATH=

# Postgres. Unset: audits are returned but not stored.
# Supabase pooler, session mode (port 5432). Render free tier is IPv4-only, the direct host is IPv6-only.
SUPABASE_DB_PASSWORD=
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_TIMEOUT_SECONDS=10

# Local tooling only (tests and scripts): path to the client's dataset. Never versioned.
LOCAL_DATASET_PATH=
